<?xml version="1.0" encoding="utf-8"?>
<!-- 사이트 배경에 맞는 기본 테마와 밝은 시스템 표시줄을 사용합니다. -->
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#237548</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F3F4EE</item>
        <item name="android:navigationBarColor">#F3F4EE</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F3F4EE</item>
    </style>
</resources>
